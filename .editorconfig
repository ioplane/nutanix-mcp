root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{cs,csx,vb,vbx}]
indent_size = 4

[*.{json,yml,yaml,toml,xml,csproj,props,targets,slnx,Directory.Build.props,Directory.Packages.props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF migrations are auto-generated — disable analyzers to avoid noise.
[src/NutanixMcp.Data/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
