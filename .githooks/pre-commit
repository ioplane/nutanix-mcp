#!/usr/bin/env bash
# Sprint 007 — pre-commit hook. Verifies that staged C# files are formatted
# per .editorconfig before allowing the commit. Fails fast with the file
# list and tells the developer how to fix.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Skip in emergencies (rare; CI will still catch the issue):
#   SKIP_FORMAT=1 git commit ...

set -euo pipefail

if [ "${SKIP_FORMAT:-}" = "1" ]; then
    echo "[pre-commit] SKIP_FORMAT=1 — skipping dotnet format check"
    exit 0
fi

# Only check if at least one staged file is C#.
staged_cs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.cs$' || true)
if [ -z "$staged_cs" ]; then
    exit 0
fi

if ! command -v dotnet >/dev/null 2>&1; then
    echo "[pre-commit] dotnet not found in PATH — skipping format check"
    exit 0
fi

echo "[pre-commit] checking dotnet format on staged C# files…"
# --verify-no-changes returns non-zero when format would change anything.
# We scope to just the staged files via --include so we don't burn time on
# the whole solution. The list is space-separated; quote each.
include_args=()
while IFS= read -r f; do
    include_args+=("--include" "$f")
done <<<"$staged_cs"

if ! dotnet format nutanix-mcp.slnx --verify-no-changes --no-restore "${include_args[@]}"; then
    echo
    echo "[pre-commit] FAILED — staged C# files are not formatted."
    echo "[pre-commit] Run: dotnet format nutanix-mcp.slnx"
    echo "[pre-commit] Or override (not recommended): SKIP_FORMAT=1 git commit ..."
    exit 1
fi

echo "[pre-commit] format clean."
exit 0
