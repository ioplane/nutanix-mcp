<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- MA0004: ConfigureAwait. Console + ASP.NET Core hosts only, never UI SyncContext. -->
    <NoWarn>$(NoWarn);MA0004;MA0051;MA0009;S6966</NoWarn>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <ErrorLog>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(MSBuildProjectName).sarif.json,version=2.1</ErrorLog>

    <!-- Inline NuGet vulnerability audit on every restore, fail at moderate. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.3.5</Version>
    <!-- Keep AssemblyVersion stable at the minor axis (0.3.0.0) so patch -->
    <!-- releases don't force downstream consumers to rebind. -->
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.5.0</FileVersion>

    <Authors>dantte-lp</Authors>
    <Company>dantte-lp</Company>
    <Product>nutanix-mcp</Product>
    <Description>Hybrid retrieval MCP server for Nutanix documentation — .NET 10 + pgvector + ONNX</Description>

    <RepositoryUrl>https://github.com/dantte-lp/nutanix-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dantte-lp/nutanix-mcp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 dantte-lp</Copyright>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.117" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913" />
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>
</Project>
