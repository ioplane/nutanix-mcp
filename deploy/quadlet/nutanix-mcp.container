[Unit]
Description=nutanix-mcp server (hybrid retrieval MCP)
# Wait for the PG service in the same Quadlet stack.
Wants=network-online.target nutanix-mcp-postgres.service
After=network-online.target nutanix-mcp-postgres.service

[Container]
ContainerName=nutanix-mcp
# Server image is built from the repo's Containerfile.release; pull from
# ghcr.io once published by the release pipeline.
Image=ghcr.io/dantte-lp/nutanix-mcp:latest

Network=nutanix-mcp.network

# Expose HTTP transport on the host. Localhost-only by default; put a
# reverse proxy in front for external exposure.
PublishPort=127.0.0.1:7456:7456

# All connection / model / GPU configuration via the env-file. See
# deploy/systemd/nutanix-mcp.env.example for the shape.
EnvironmentFile=/etc/nutanix-mcp.env

# Models live on the host so we don't bake 1+ GB of weights into every
# image build. Read-only — the server only reads the ONNX assets.
Volume=%h/.local/share/nutanix-mcp/models:/var/lib/nutanix-mcp/models:Z,ro

HealthCmd=curl --fail --silent http://127.0.0.1:7456/v1/healthz
HealthInterval=15s
HealthRetries=5
HealthStartPeriod=60s
HealthTimeout=10s

AutoUpdate=registry
Label=io.containers.autoupdate=registry

# Hardening — minimal capabilities, read-only root.
ReadOnly=true
NoNewPrivileges=true
Tmpfs=/tmp:rw,size=64m,mode=1777
DropCapability=ALL
AddCapability=NET_BIND_SERVICE

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s

[Install]
WantedBy=default.target
