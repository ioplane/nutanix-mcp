# Sample environment file for the nutanix-mcp systemd unit.
# Copy to /etc/nutanix-mcp.env, restrict ownership (root:root, mode 0600),
# and edit per host.
#
#   sudo cp deploy/systemd/nutanix-mcp.env.example /etc/nutanix-mcp.env
#   sudo chmod 0600 /etc/nutanix-mcp.env
#   sudo $EDITOR /etc/nutanix-mcp.env

# Postgres connection. The DB must already have the nutanix-mcp schema
# (run `dotnet ef database update --project src/NutanixMcp.Data` once)
# and the corpus ingested (`nutanix-mcp ingest --catalog ...`).
NUTANIX_MCP__CONNECTIONSTRING=Host=127.0.0.1;Port=5432;Database=nutanix;Username=nutanix;Password=changeme

# Where the ONNX models live. The directory must contain `embedder/` and
# `reranker/` subdirectories, populated by scripts/fetch-models.ps1 (or
# unzipped from a release attachment). Defaults to ./models if unset.
NUTANIX_MCP__MODELSDIR=/var/lib/nutanix-mcp/models

# Optional: override the reranker directory for v0.3.0 fine-tune /
# INT8 variants. Leave commented to use ${MODELSDIR}/reranker (stock
# FP32). The recommended production default for CPU laptops is the
# INT8 fine-tune.
# NUTANIX_MCP__RERANKERDIR=/var/lib/nutanix-mcp/models/reranker-finetuned-int8

# Optional: GPU acceleration for the embedder + reranker (requires
# Microsoft.ML.OnnxRuntime.Gpu + a CUDA 12.x runtime on the host).
# NUTANIX_MCP__GPU=true

# Optional: minutes without a query before the ONNX models are released
# (~2.7 GB RSS -> ~260 MB); the next query reloads them. 0 keeps them
# loaded. See docs/en/operations.md § Server memory.
# NUTANIX_MCP__MODELIDLEUNLOADMINUTES=10

# Optional: OpenTelemetry endpoint. The MCP server emits
# `nutanix-mcp` ActivitySource spans; tracing is opt-in.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
