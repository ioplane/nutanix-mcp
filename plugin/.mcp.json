{
  "mcpServers": {
    "nutanix-mcp": {
      "command": "nutanix-mcp",
      "args": ["serve", "--transport", "stdio"],
      "env": {
        "NUTANIX_MCP__ConnectionString": "${NUTANIX_MCP__ConnectionString}",
        "NUTANIX_MCP__ModelsDir": "${NUTANIX_MCP__ModelsDir}",
        "NUTANIX_MCP__RerankerDir": "${NUTANIX_MCP__RerankerDir:-}"
      }
    }
  }
}
